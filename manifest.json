{
  "manifest_version": 3,
  "name": "Vinted Companion — Outils & Analyse",
  "version": "1.2.0",
  "description": "Analyse locale, suivi des prix, inventaire, marges et préparation d’annonces. Compatible Chrome et Firefox.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://vinted.fr/*",
    "https://www.vinted.fr/*",
    "https://vinted.be/*",
    "https://www.vinted.be/*",
    "https://vinted.de/*",
    "https://www.vinted.de/*",
    "https://vinted.es/*",
    "https://www.vinted.es/*",
    "https://vinted.it/*",
    "https://www.vinted.it/*",
    "https://vinted.nl/*",
    "https://www.vinted.nl/*",
    "https://vinted.pl/*",
    "https://www.vinted.pl/*",
    "https://vinted.pt/*",
    "https://www.vinted.pt/*"
  ],
  "action": {
    "default_title": "Vinted Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vinted.fr/*",
        "https://www.vinted.fr/*",
        "https://vinted.be/*",
        "https://www.vinted.be/*",
        "https://vinted.de/*",
        "https://www.vinted.de/*",
        "https://vinted.es/*",
        "https://www.vinted.es/*",
        "https://vinted.it/*",
        "https://www.vinted.it/*",
        "https://vinted.nl/*",
        "https://www.vinted.nl/*",
        "https://vinted.pl/*",
        "https://www.vinted.pl/*",
        "https://vinted.pt/*",
        "https://www.vinted.pt/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vinted-companion@lpsqtdev.netizen",
      "strict_min_version": "128.0"
    }
  }
}
